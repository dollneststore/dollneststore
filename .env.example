# Copy to .env.local for local development and add the same values in
# Vercel → Project → Settings → Environment Variables.

# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://dollneststore.co.uk

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only secret. Never prefix with NEXT_PUBLIC_.
# Used for newsletter sign-ups and the seed/import scripts.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Etsy Open API v3 — only needed for `pnpm import:etsy`
# https://www.etsy.com/developers/your-apps
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_SHOP_NAME=DollNestStore

# Stripe → Developers → API keys. Use the test keys (sk_test_/pk_test_) until the
# whole flow has been tried with Stripe's test cards, then swap in the live ones.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe → Developers → Webhooks → your endpoint → signing secret (whsec_...).
# Without it the webhook refuses every request, so no order can be marked paid.
STRIPE_WEBHOOK_SECRET=
